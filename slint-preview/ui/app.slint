import { ScrollView } from "std-widgets.slint";

export struct DustLayer { picture:image, delay:float, drift-x:float, drift-y:float, swirl:float }
export struct CardData { id:int, added-relative:string, added-exact:string, multiline:bool, snap-ready:bool, snap-running:bool, snap-layers:[DustLayer], snap-backdrop:image, snap-x:float, snap-y:float, snap-width:float, snap-height:float, frozen-height:float, dissolving:bool, collapsing:bool, body:string, preview:image, has-image:bool, image-count:int, file-count:int, done:bool, due:bool, reminder:string }

component Action inherits Rectangle {
    in property<string> label;
    in property<bool> primary:false;
    in property<bool> quiet:false;
    callback clicked();
    height:38px;
    border-radius:12px;
    background: root.primary ? (hit.pressed ? #ae5734 : hit.has-hover ? #c66c44 : #d77d53) : (hit.has-hover ? #eee7df : root.quiet ? transparent : #f3eee8);
    animate background { duration:100ms; }
    Text { text:root.label; color:root.primary ? #ffffff : #7a685b; font-size:13px; horizontal-alignment:center; vertical-alignment:center; }
    hit:=TouchArea { mouse-cursor:pointer; clicked=>{root.clicked();} }
}

export struct RailCard {id:int, body:string, added:string, created:string, completing:bool}
export component RailWindow inherits Window {
    width:272px;height:314px;no-frame:true;always-on-top:true;background:transparent;
    default-font-family:"Microsoft YaHei UI";
    in property<[RailCard]> entries;
    in-out property<int> current:0;
    in property<bool> left-side:true;
    in property<bool> can-undo:false;
    in property<bool> empty-message:false;
    in property<bool> preview-visible:false;
    callback preview-hover(bool);
    in-out property<bool> menu-open:false;
    in property<int> busy-id:-1;
    in property<[DustLayer]> layers;
    in property<image> backdrop;
    in property<bool> dust-running:false;
    private property<float> dust:dust-running?1:0;
    animate dust{duration:1100ms;easing:linear;}
    callback step(int);callback detail(int);callback complete(int);callback flip();callback undo();callback shape-changed();
    changed current=>{root.shape-changed();}
    changed entries=>{root.shape-changed();}
    changed can-undo=>{root.shape-changed();}
    changed empty-message=>{root.shape-changed();}
    changed menu-open=>{root.shape-changed();}
    for entry[index] in root.entries : bubble:=Rectangle {
        x:index==root.current?16px:24px;y:119px + (index - root.current)*82px;
        width:index==root.current?240px:224px;height:76px;
        visible:index>=root.current - 1 && index<=root.current + 1;
        opacity:index==root.current?1:0.48;
        animate y{duration:180ms;easing:ease-out;}animate x{duration:180ms;}animate opacity{duration:180ms;}
        private property<bool> hovered:body-hit.has-hover || finish.has-hover || menu-hit.has-hover;
        Rectangle{width:parent.width;height:parent.height;border-radius:14px;background:#faf8f4;border-width:index==root.current?1px:0px;border-color:#e8dacc;opacity:root.busy-id==entry.id?0:1;
            Text{x:12px;y:10px;width:parent.width - 50px;height:38px;text:entry.body;wrap:word-wrap;overflow:elide;font-size:13px;color:#514033;}
            Text{x:12px;y:54px;text:entry.added;font-size:10px;color:#aa9685;}
            body-hit:=TouchArea{width:parent.width;height:parent.height;mouse-cursor:pointer;
                scroll-event(event)=>{if root.busy-id<0 && event.delta-y!=0px {root.step(event.delta-y<0px?1:-1);}return accept;}
                clicked=>{if root.busy-id<0 {if index==root.current {root.detail(entry.id);} else {root.step(index - root.current);}}}
            }
            Rectangle{x:206px;y:23px;width:26px;height:26px;visible:index==root.current && bubble.hovered;border-radius:13px;border-width:1px;border-color:#cfb6a0;background:finish.has-hover?#f0dfce:#fffdf9;
                Image{x:6px;y:6px;width:14px;height:14px;source:@image-url("check.svg");image-fit:contain;}
                finish:=TouchArea{mouse-cursor:pointer;clicked=>{if root.busy-id<0 && !entry.completing {root.complete(entry.id);}}}
            }
            Rectangle{x:180px;y:51px;width:22px;height:20px;visible:index==root.current && bubble.hovered;
                Text{width:parent.width;height:parent.height;text:"···";color:#9b806b;horizontal-alignment:center;vertical-alignment:center;}
                menu-hit:=TouchArea{mouse-cursor:pointer;clicked=>{root.menu-open=!root.menu-open;}}
            }
        }
    }
    if root.busy-id>=0 : Rectangle{x:16px;y:119px;width:240px;height:76px;
        Image{width:parent.width;height:parent.height;source:root.backdrop;image-fit:fill;opacity:1-root.dust;}
        for layer in root.layers : Image{
            private property<float> flight:max(0,min(1,(root.dust - layer.delay)/(1 - layer.delay)));
            x:layer.drift-x*self.flight*1px;y:layer.drift-y*self.flight*1px;width:240px;height:76px;source:layer.picture;image-fit:fill;opacity:1-self.flight;
        }
    }
    if root.entries.length==0 && root.empty-message : Rectangle{x:16px;y:119px;width:240px;height:76px;border-radius:14px;background:#faf8f4;
        Text{width:parent.width;height:parent.height;text:"都处理好了";horizontal-alignment:center;vertical-alignment:center;color:#ac9582;font-size:13px;}
    }
    if root.can-undo : Rectangle{x:84px;y:284px;width:104px;height:26px;border-radius:13px;background:#fff6e9;
        Text{width:parent.width;height:parent.height;text:"撤销完成";font-size:11px;color:#947455;horizontal-alignment:center;vertical-alignment:center;}
        TouchArea{mouse-cursor:pointer;clicked=>{root.undo();}}
    }
    if root.menu-open : Rectangle{x:136px;y:201px;width:120px;height:72px;border-radius:12px;background:#fffdf9;border-width:1px;border-color:#e8dacc;
        VerticalLayout{padding:6px;spacing:2px;
            Action{label:root.left-side?"移到右侧":"移到左侧";height:28px;quiet:true;clicked=>{root.menu-open=false;root.flip();}}
            Action{label:"收起菜单";height:28px;quiet:true;clicked=>{root.menu-open=false;}}
        }
    }
}
export component PetWindow inherits Window {
    in property<[RailCard]> rail-notes;
    in property<bool> rail-undo:false;
    callback rail-updated();callback rail-place();callback rail-check();
    callback preview-hover(bool);callback preview-drag(bool);
    out property<bool> preview-hovered:cat-hit.has-hover || count-hit.has-hover || (root.status-visible && badge-hit.has-hover);
    in property<bool> native-hover-events:false;
    changed preview-hovered=>{if !root.native-hover-events {root.preview-hover(root.preview-hovered);}}
    width:180px; height:172px; background:transparent; no-frame:true; always-on-top:true;
    default-font-family:"Microsoft YaHei UI";
    in property<int> count;
    in property<int> due-count;
    out property<bool> status-visible:root.drop-hover || root.drop-busy || root.toast!="" || root.nudge-text!="" || root.due-count>0 || root.can-undo;
    in property<bool> happy:false;
    in property<bool> celebrating:false;
    in property<bool> nudging:false;
    in property<string> nudge-text;
    in-out property<int> nudge-token;
    in property<bool> drop-hover:false;
    in property<bool> drop-busy:false;
    Rectangle{x:8px;y:2px;width:150px;height:128px;border-radius:30px;background:root.drop-hover?#30edbc84:transparent;border-width:root.drop-hover?2px:0px;border-color:#dfa066;animate background{duration:100ms;}}
    in property<string> toast;
    in property<bool> can-undo:false;
    in property<bool> toast-error:false;
    callback undo();
    callback open-record(); callback open-tasks(); callback drag(float,float); callback drag-finished();
    private property<length> origin-x; private property<length> origin-y;
    private property<bool> was-dragged:false;
    Image { source:@image-url("cat.svg"); x:root.celebrating?13px:19px; y:root.happy || root.nudging ? 0px : 7px; width:root.celebrating?140px:128px; height:root.celebrating?120px:128px; animate width {duration:240ms;} animate height {duration:240ms;} animate x {duration:240ms;} image-fit:contain; animate y {duration:170ms;easing:ease-out;} }
    cat-hit:=TouchArea { x:12px;y:0px;width:142px;height:133px;mouse-cursor:pointer;
        pointer-event(event)=>{
            if event.kind == PointerEventKind.down {root.preview-drag(true);root.origin-x=self.mouse-x;root.origin-y=self.mouse-y;root.was-dragged=false;}
            if event.kind == PointerEventKind.up {root.preview-drag(false);root.drag-finished();}
        }
        moved=>{if self.pressed {
            if self.mouse-x - root.origin-x>4px || self.mouse-x - root.origin-x < -4px || self.mouse-y - root.origin-y>4px || self.mouse-y - root.origin-y < -4px {
                root.was-dragged=true;root.drag((self.mouse-x - root.origin-x)/1px,(self.mouse-y - root.origin-y)/1px);
            }
        }}
        clicked=>{if !root.was-dragged {root.open-record();}}
    }
    Rectangle {x:140px;y:8px;width:root.count>99?36px:root.count>9?30px:24px;height:24px;
        visible:root.count>0;border-radius:12px;background:#fffaf5;border-width:1px;border-color:#e8dacc;
        Text {text:root.count>99?"99+":root.count;color:#796354;font-size:12px;font-weight:600;horizontal-alignment:center;vertical-alignment:center;}
        count-hit:=TouchArea {mouse-cursor:pointer;clicked=>{root.open-record();}}
    }
    Rectangle {visible:root.status-visible;x:6px;y:137px;width:154px;height:30px;border-radius:15px;background:root.can-undo||root.due-count>0?#f7e6d7:#fffaf5;border-width:1px;border-color:#e8dacc;        animate background {duration:120ms;}
        Text {text:root.drop-hover?"松手，放进口袋":root.drop-busy?"正在收下…":root.toast!=""?root.toast:root.nudge-text!=""?root.nudge-text:root.due-count>0?"有 " + root.due-count + " 条提醒 · 查看":"已收下";color:#796354;font-size:12px;horizontal-alignment:center;vertical-alignment:center;}
        badge-hit:=TouchArea {mouse-cursor:pointer;clicked=>{if root.drop-hover||root.drop-busy {} else if root.can-undo {root.undo();} else if root.toast-error {root.open-record();} else {root.open-tasks();}}}
    }
}

export component PocketWindow inherits Window {
    title:"口袋 · Slint 预览";width:448px;height:root.panel-height * 1px;
    out property<float> panel-height:570;
    in-out property<int> expanded-id: -1;
    in-out property<int> editing-id: -1;
    in-out property<int> reminder-id: -1;
    in-out property<bool> menu-open:false;
    in property<int> done-count;
    in property<int> fresh-id:-1;
    in property<bool> fresh-settled:true;
    in property<bool> has-draft-reminder:false;
    callback time-visibility();
    changed revealed=>{root.time-visibility();root.rail-status();}
    callback rail-status();
    changed completion-undo=>{root.rail-status();}
    callback notice-updated();
    private property<string> last-notice;
    changed notice=>{if root.notice!="" {root.last-notice=root.notice;} root.notice-updated();}
    callback preview-image(int,int);
    callback close-image();
    in property<bool> zoom-open:false;
    in property<image> zoom-image;
    in property<int> zoom-note:-1;
    in property<int> zoom-index;
    in property<int> zoom-count;
    in-out property<string> edit-body;
    callback inline-text(int,string);
    callback inline-paste(int) -> bool;
    callback inline-reminder(int,int);

    callback inline-remove(int);
    callback begin-completion(int,float,float,float,float,float,float);
    in property<int> completion-request:-1;
    in property<bool> capturing:false;
    callback viewed();
    callback undo-complete();
    in property<bool> completion-undo:false;
    in property<int> focus-token;
    in property<string> reminder-label;
    in property<string> later-label;
    in-out property<bool> reminder-options:false;
    callback choose-reminder(int); callback snooze(int); callback acknowledge(int); callback schedule-reminders(float);
    background:transparent;no-frame:true;always-on-top:true;default-font-family:"Microsoft YaHei UI";
    in property<bool> revealed:false;
    in-out property<bool> task-view:false;
    in-out property<string> draft;
    in property<bool> editing:false;
    in property<bool> drop-busy:false;
    in property<int> file-count;
    callback drop-ready(); callback show-files(int);
    in property<bool> has-attachment:false;
    in property<image> attachment;
    in property<int> attachment-count;
    in property<int> pending-count;
    in property<[CardData]> cards;
    in property<bool> show-done:false;
    in property<string> notice;
    callback save();callback draft-edited(string);callback paste-image() -> bool;callback capture();callback remove-image();
    callback toggle(int);callback edit(int);callback fold();callback dismiss();callback quit();callback change-view(bool);
    Rectangle {
        x:12px;y:root.revealed?12px:20px;width:parent.width - 24px;height:parent.height - 24px;
        opacity:root.revealed?1:0;
        animate opacity {duration:160ms;easing:ease-out;}
        animate y {duration:160ms;easing:ease-out;}
        background:#fffdf9;border-radius:24px;border-width:1px;border-color:#eadfd3;
        drop-shadow-color:#183d2817;drop-shadow-blur:12px;drop-shadow-offset-y:4px;
        VerticalLayout {
            padding:18px;spacing:10px;
            HorizontalLayout {height:30px;spacing:8px;
                Rectangle {width:28px;height:28px;border-radius:9px;background:#f7e6d7;Text{text:"口";color:#b4774c;font-size:16px;horizontal-alignment:center;vertical-alignment:center;}}
                Text{text:"口袋";font-size:14px;font-weight:600;color:#695447;vertical-alignment:center;}
                Rectangle {horizontal-stretch:1;}
                Action {width:28px;height:28px;quiet:true;label:"...";clicked=>{root.menu-open=!root.menu-open;}}
                Action {width:28px;height:28px;quiet:true;label:"×";clicked=>{root.dismiss();}}
            }
            VerticalLayout {spacing:6px;vertical-stretch:0;
                Rectangle {height:(root.draft!=""?68px:56px) + (root.has-attachment?60px:0px);background:#f7f3ed;border-radius:16px;border-width:1px;border-color:input.has-focus?#dbb89c:#eee5dc;
                    animate border-color {duration:120ms;}
                    if root.draft=="" : Text {x:14px;y:15px;text:"记点什么…";color:#baa99a;font-size:15px;}
                    input:=TextInput {
                        x:14px;y:12px;width:parent.width - 108px;height:root.draft!=""?40px:30px;
                        text<=>root.draft;single-line:false;wrap:word-wrap;color:#504033;font-size:15px;
                        in property<int> focus-trigger:root.focus-token;
                        init=>{self.focus();}
                        changed focus-trigger=>{self.focus();}
                        edited=>{root.draft-edited(self.text);}
                        key-pressed(event)=>{
                            if self.preedit-text!="" {return reject;}
                            if event.text==Key.Escape {root.dismiss();return accept;}
                            if event.text==Key.Return && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt {
                                root.save();return accept;
                            }
                            if (event.modifiers.control && (event.text=="v" || event.text=="V")) || (event.modifiers.shift && event.text==Key.Insert) {
                                if root.paste-image() {return accept;}
                            }
                            return reject;
                        }
                    }
                    Action{x:parent.width - 88px;y:root.draft!=""?30px:14px;width:76px;height:28px;primary:true;label:"收下";clicked=>{root.save();}}
                    if root.has-attachment : Rectangle {x:14px;y:root.draft!=""?68px:56px;width:parent.width - 28px;height:52px;border-radius:12px;background:#fffdf9;
                        Image {x:8px;y:8px;width:64px;height:36px;source:root.attachment;image-fit:contain; TouchArea{mouse-cursor:pointer;clicked=>{root.preview-image(-1,0);}}}
                        Text {x:root.attachment-count>0?94px:14px;y:17px;width:parent.width - (root.attachment-count>0?230px:150px);overflow:elide;text:root.file-count>0?root.file-count + " 个文件" + (root.attachment-count>0?" · " + root.attachment-count + " 张图片":""):root.attachment-count + " 张图片";font-size:12px;color:#9c8371;}
                        if root.file-count>0 : Action{x:parent.width - 126px;y:11px;width:72px;height:30px;quiet:true;label:"查看文件";clicked=>{root.show-files(-1);}}
                        Action{x:parent.width - 48px;y:11px;width:32px;height:30px;quiet:true;label:"×";clicked=>{root.remove-image();}}
                    }
                }
                if root.has-draft-reminder : HorizontalLayout {height:24px;
                    Text{text:root.reminder-label;font-size:11px;color:#a18772;vertical-alignment:center;}
                    Action{label:"取消提醒";quiet:true;width:68px;height:24px;clicked=>{root.choose-reminder(0);}}
                }
            }
            VerticalLayout {spacing:8px;vertical-stretch:1;
                HorizontalLayout {height:26px;
                    Text{text:"待办";color:#695447;font-size:14px;font-weight:700;}
                    Rectangle{horizontal-stretch:1;}
                    Text{text:root.pending-count + " 件待处理";font-size:12px;color:#ad8b73;vertical-alignment:center;}
                }
                task-scroll:=ScrollView {vertical-stretch:1;vertical-scrollbar-policy:root.capturing?ScrollBarPolicy.always-off:ScrollBarPolicy.as-needed;horizontal-scrollbar-policy:root.capturing?ScrollBarPolicy.always-off:ScrollBarPolicy.as-needed;
                    VerticalLayout {spacing:10px;
                        for card in root.cards : card-shell:=Rectangle {
                            private property<length> base-height:card.dissolving && card.frozen-height>0 ? card.frozen-height*1px : root.expanded-id==card.id?(210px+(card.has-image||card.file-count>0?54px:0px)+(root.reminder-id==card.id?34px:0px)):card.due?128px:card.has-image?112px:card.reminder!=""||card.file-count>0?80px:card.multiline?80px:72px;
                            private property<float> arrival:root.fresh-id==card.id && !root.fresh-settled?0:1;
                            opacity:root.expanded-id==card.id?1:self.arrival;animate arrival{duration:180ms;easing:ease-out;}
                            private property<float> dust:card.snap-running?1:0;
                            in property<int> requested:root.completion-request;
                            function begin() {
                                root.begin-completion(card.id,self.absolute-position.x/1px,self.absolute-position.y/1px,self.width/1px,self.height/1px,task-scroll.absolute-position.y/1px,(task-scroll.absolute-position.y+task-scroll.height)/1px);
                            }
                            changed requested=>{if self.requested==card.id {self.begin();}}
                            animate dust {duration:1100ms;easing:linear;}
                            height:card.collapsing?0px:self.base-height;
                            animate height {duration:200ms;easing:ease-in-out;}
                            clip:false;
                            Rectangle {x:0px;y:0px;width:parent.width;height:parent.height;clip:true;opacity:card.snap-ready?0:1;
                              Rectangle {x:0px;y:0px;width:card-shell.width;height:card-shell.base-height;border-radius:16px;background:root.fresh-id==card.id?#f5e5ce:card.due?#faf2e7:card-hover.has-hover?#f4eee5:#faf8f4;border-width:card.due?1px:0px;border-color:#e8d1b5;animate background{duration:300ms;}
                            card-hover:=TouchArea {}
                            Rectangle{x:14px;y:18px;width:22px;height:22px;border-radius:11px;border-width:1px;border-color:card.done||card.dissolving?#b7c5a6:#d2bdab;background:card.done||card.dissolving?#e5ecdd:#fffdf9;
                                if card.done || card.dissolving : Image{x:4px;y:4px;width:14px;height:14px;source:@image-url("check.svg");image-fit:contain;}
                                TouchArea{enabled:!card.dissolving;mouse-cursor:pointer;clicked=>{card-shell.begin();}}
                            }
                            if root.expanded-id!=card.id : Text{x:48px;y:card.multiline||card.has-image||card.reminder!=""||card.file-count>0?14px:17px;width:parent.width - (card.has-image?142px:66px);height:40px;text:card.body==""?"图片备忘":card.body;font-size:14px;color:card.done?#a9998a:#514033;wrap:word-wrap;overflow:elide;}
                            if root.expanded-id!=card.id && (card.reminder!="" || card.file-count>0) : Text{x:48px;y:card.due?64px:parent.height - 22px;width:parent.width - 166px;overflow:elide;text:card.reminder!=""?"提醒："+card.reminder:card.file-count + " 个文件";font-size:11px;color:#aa907b;}
                            if root.expanded-id!=card.id : Text{x:parent.width - 120px;y:card.due?64px:parent.height - 22px;width:104px;height:16px;text:card.added-relative;font-size:10px;color:#aa9685;horizontal-alignment:right;}
                            if root.expanded-id!=card.id : TouchArea{x:44px;y:0;width:parent.width - 44px;height:parent.height;mouse-cursor:pointer;clicked=>{root.edit(card.id);}}
                            if card.has-image && root.expanded-id!=card.id : Image{x:parent.width - 88px;y:14px;width:72px;height:68px;source:card.preview;image-fit:contain;TouchArea{mouse-cursor:pointer;clicked=>{root.preview-image(card.id,0);}}}
                            if root.expanded-id==card.id : VerticalLayout {
                                x:48px;y:12px;width:parent.width - 62px;height:parent.height - 24px;spacing:6px;
                                HorizontalLayout {height:24px;
                                    Text{text:root.editing-id==card.id?"编辑内容":"记录内容";font-size:11px;color:#a18772;}
                                    Rectangle{horizontal-stretch:1;}
                                    if root.editing-id!=card.id : Action{label:"编辑";height:24px;width:44px;quiet:true;clicked=>{root.editing-id=card.id;}}
                                    Action{label:"收起";height:24px;width:44px;quiet:true;clicked=>{root.edit(card.id);}}
                                }
                                Text{height:16px;text:card.added-exact;font-size:10px;color:#aa9685;}
                                Rectangle {height:88px;background:#fffdf9;border-radius:8px;
                                    if root.editing-id==card.id : TextInput {x:8px;y:8px;width:parent.width - 16px;height:72px;text<=>root.edit-body;wrap:word-wrap;single-line:false;font-size:14px;color:#514033;
                                        init=>{self.focus();}
                                        edited=>{root.inline-text(card.id,self.text);}
                                        key-pressed(event)=>{
                                            if self.preedit-text!="" {return reject;}
                                            if event.text==Key.Escape {root.edit(card.id);return accept;}
                                            if (event.modifiers.control && (event.text=="v" || event.text=="V")) || (event.modifiers.shift && event.text==Key.Insert) {
                                                if root.inline-paste(card.id) {return accept;}
                                            }
                                            return reject;
                                        }
                                    }
                                    if root.editing-id!=card.id : ScrollView{x:8px;y:8px;width:parent.width - 16px;height:72px;
                                        Text {text:root.edit-body==""?"添加一句说明…":root.edit-body;wrap:word-wrap;color:#514033;font-size:14px;
                                            TouchArea{mouse-cursor:text;clicked=>{root.editing-id=card.id;}}
                                        }
                                    }
                                }
                                if card.has-image || card.file-count>0 : HorizontalLayout {height:48px;spacing:6px;
                                    if card.has-image : Image{width:64px;source:card.preview;image-fit:contain;TouchArea{mouse-cursor:pointer;clicked=>{root.preview-image(card.id,0);}}}
                                    Text{text:card.image-count + " 张图片 · " + card.file-count + " 个文件";font-size:10px;color:#a18772;vertical-alignment:center;}
                                    if card.file-count>0 : Action{label:"文件";width:40px;height:28px;clicked=>{root.show-files(card.id);}}
                                    if card.has-image || card.file-count>0 : Action{label:"移除";width:40px;height:28px;clicked=>{root.inline-remove(card.id);}}
                                }
                                Action{label:card.reminder!=""?card.reminder:"设置提醒";height:28px;quiet:true;clicked=>{root.reminder-id=root.reminder-id==card.id?-1:card.id;}}
                                if root.reminder-id==card.id : HorizontalLayout {height:28px;spacing:4px;
                                    Action{label:"不提醒";height:28px;clicked=>{root.inline-reminder(card.id,0);}}
                                    Action{label:"30 分钟后";height:28px;clicked=>{root.inline-reminder(card.id,1);}}
                                    Action{label:root.later-label;height:28px;clicked=>{root.inline-reminder(card.id,2);}}
                                }
                            }
                            if card.due && root.expanded-id!=card.id : HorizontalLayout {x:48px;y:96px;width:parent.width - 64px;height:28px;spacing:8px;
                                Action{label:"30 分钟后";height:28px;clicked=>{root.snooze(card.id);}}
                                Action{label:"知道了";height:28px;quiet:true;clicked=>{root.acknowledge(card.id);}}
                            }
                        }                            }
                            if card.snap-ready && !root.capturing : Rectangle {x:0px;y:0px;width:parent.width;height:card-shell.base-height;
                                Image {x:card.snap-x*1px;y:card.snap-y*1px;width:card.snap-width*1px;height:card.snap-height*1px;source:card.snap-backdrop;image-fit:fill;opacity:1 - min(1,max(0,(card-shell.dust - 0.12)/0.7));}
                                for layer in card.snap-layers : Image {
                                    private property<float> flight:max(0,min(1,(card-shell.dust - layer.delay)/(1 - layer.delay)));
                                    x:card.snap-x*1px + (layer.drift-x*self.flight + Math.sin(self.flight*360deg)*layer.swirl*self.flight)*1px;
                                    y:card.snap-y*1px + (layer.drift-y*self.flight - Math.sin(self.flight*180deg)*6)*1px;
                                    width:card.snap-width*1px;height:card.snap-height*1px;
                                    source:layer.picture;image-fit:fill;opacity:1 - self.flight*self.flight;
                                }
                            }
                            if card.dissolving : TouchArea {}
                        }
                        if root.cards.length==0 : Rectangle{height:80px;Text{text:root.done-count>0?"都处理好了，想到什么再记下来。":"还没有待办，在上面记下第一件事。";color:#b49b87;font-size:15px;horizontal-alignment:center;vertical-alignment:center;}}
                    }
                }
                if root.done-count>0 : Action{label:(root.show-done?"收起已完成 · ":"已完成 · ") + root.done-count;height:28px;quiet:true;clicked=>{root.fold();}}
            }

        }        Rectangle {x:18px;y:parent.height - 44px;width:parent.width - 36px;height:28px;border-radius:10px;background:#fff6e9;
            opacity:root.notice!=""||root.completion-undo?1:0;animate opacity{duration:180ms;}
            Text{x:10px;width:parent.width - (root.completion-undo?92px:20px);height:parent.height;text:root.last-notice;font-size:11px;color:#947455;overflow:elide;vertical-alignment:center;}
            if root.completion-undo : Action{x:parent.width - 80px;width:76px;height:28px;quiet:true;label:"撤销完成";clicked=>{root.undo-complete();}}
        }
        if root.menu-open : Rectangle {width:parent.width;height:parent.height;background:transparent;
            TouchArea{clicked=>{root.menu-open=false;}}
            Rectangle{x:parent.width - 164px;y:52px;width:144px;height:88px;background:#fffdf9;border-radius:12px;border-width:1px;border-color:#eadfd3;
                VerticalLayout{padding:8px;spacing:4px;
                    Action{label:"收下剪贴板";height:32px;quiet:true;clicked=>{root.menu-open=false;root.capture();}}
                    Action{label:"退出口袋";height:32px;quiet:true;clicked=>{root.quit();}}
                }
            }
        }
        if root.zoom-open : Rectangle {x:0px;y:0px;width:parent.width;height:parent.height;background:#fffdf9;border-radius:24px;
            FocusScope{width:parent.width;height:parent.height;init=>{self.focus();}key-pressed(event)=>{if event.text==Key.Escape {root.close-image();return accept;}return reject;}}
            VerticalLayout{padding:18px;spacing:12px;
                HorizontalLayout{height:30px;
                    Text{text:"图片 " + (root.zoom-index + 1) + " / " + root.zoom-count;font-size:14px;color:#695447;vertical-alignment:center;}
                    Rectangle{horizontal-stretch:1;}
                    Action{label:"收起";width:52px;height:28px;quiet:true;clicked=>{root.close-image();}}
                }
                Rectangle{vertical-stretch:1;background:#f7f4ee;border-radius:12px;
                    Image{width:parent.width;height:parent.height;source:root.zoom-image;image-fit:contain;}
                    TouchArea{mouse-cursor:pointer;clicked=>{root.close-image();}}
                }
                if root.zoom-count>1 : HorizontalLayout{height:30px;spacing:8px;
                    Action{label:"上一张";height:30px;clicked=>{root.preview-image(root.zoom-note,Math.mod(root.zoom-index + root.zoom-count - 1,root.zoom-count));}}
                    Action{label:"下一张";height:30px;clicked=>{root.preview-image(root.zoom-note,Math.mod(root.zoom-index + 1,root.zoom-count));}}
                }
            }
        }

    }
}
